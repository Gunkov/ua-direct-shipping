{
    "name": "gunkov/ua-direct-shipping",
    "description": "WooCommerce shipping integration for Nova Poshta (and Ukrposhta planned). Direct API, no cloud proxies.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sergiy Gunkov",
            "homepage": "https://gunkov.pp.ua"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Gunkov\\UAShipping\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
